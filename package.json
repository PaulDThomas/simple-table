{
  "name": "@asup/simple-table",
  "version": "2.1.0",
  "description": "REACT table, because I wanted one that took an array of objects as an input.",
  "author": "Paul Thomas <@PaulDThomas>",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaulDThomas/simple-table.git"
  },
  "keywords": [
    "react",
    "typescript",
    "simple",
    "array-of-objects",
    "table"
  ],
  "bugs": {
    "url": "https://github.com/PaulDThomas/simple-table/issues"
  },
  "homepage": "https://github.com/PaulDThomas/simple-table",
  "main": "dist/cjs/main.js",
  "module": "dist/esm/main.js",
  "types": "dist/esm/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "vitest run --coverage",
    "test-watch": "vitest --watch --coverage --maxWorkers=4",
    "eslint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:esm && npm run build:cjs && npm run build:types",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:esm": "vite build --mode esm",
    "build:cjs": "vite build --mode cjs",
    "build:types": "tsc --project tsconfig.build.json"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@swc/helpers": "^0.5.17",
    "lodash": "^4.17.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "process": "^0.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "storybook": "^10.1.2",
    "@storybook/react-vite": "^10.1.2",
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-vitest": "^10.1.2",
    "@storybook/addon-a11y": "^10.1.2",
    "@storybook/addon-docs": "^10.1.2",
    "@storybook/addon-onboarding": "^10.1.2",
    "vitest": "^4.0.14",
    "playwright": "^1.57.0",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "jsdom": "^26.1.0",
    "vite": "^7.1.12"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
